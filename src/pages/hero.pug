section.hero
    .hero__inner.container
        .hero__text
            h1 Турбота про вашого улюбленця
            p.hero__lead Запис до лікаря онлайн за 3 хвилини
            a.btn.btn--solid(href='#booking') Записатися на прийом
        .hero__media
            span.hero__circle
            img.hero__img(src='/img/hero.png' alt='Ветеринарка оглядає собаку')
            .hero__badge
                +icon('star')
                span 4,9 · 1200+ відгуків
